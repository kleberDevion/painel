env.load('/home/kleberdevion/projetos/painel/.env');

public class warningPanel {
    # private static list dns = system.getenv('DOMAINS')
    # Routesapp não carrega __name__ pois não e este aqruivo que executa como main
    public static Object Routesapp = Jinker( 
        oauth={
            'poolip': true,
            'rate': true,
            'tls': true,
            'bloq': 20000,
            'cert': '/home/kleberdevion/projetos/painel/api/service/.config/certificate.jinkerTls',
            'key': '/home/kleberdevion/projetos/painel/api/service/.config/key.jinkerTls.key'
        }, route_prefix='/api/v1/'
    );
    private static Object CrossOrigin = cors(Routesapp, origins=['https://api.tecsolengenharia.com.br', 'https://auth.tecsolengenharia.com.br'], local=true)
    # MIDDLEWARE PARA AUTENTICAÇÃO DE TOKEN WEBHOOK
    @Routesapp.middleware()
    public funct middle(self){
        if (UNTILS.getTokensWebhook(request.headers.get('Authorization')) == false){
            return JinkerResponse()
                   .header('Content-Type', 'application/json')
                   .json({'status': 403, 'message': 'Forbidden'})
        }
    }

    # Rota de teste para verificar se o servidor está online
    @Routesapp.get('/', auth=CrossOrigin.origins(), middleware=Routesapp.middleware)
    public funct healthcheck(self){
        return JinkerResponse()
               .header('Content-Type', 'application/json')
               .json({'status': 200, 'message': 'Vai se fuder'})
    }

    # Rota de login no painel
    @Routesapp.post('/loginpanel:form', auth=CrossOrigin.origins(), model=LoginPAINEL, middleware=Routesapp.middleware)
    public funct handlerLogin(self, dict form){
        if (!PanelDoctors.DoctorBody(form) == false){
            return JinkerResponse()
                   .header('Content-Type', 'application/json')
                   .json({'status': 400, 'message': 'Bad request'})
        }
        try{
            dict infos = PersonOperadorLogin.login(data=form)
            if (infos.status == 200){
                return JinkerResponse()
                       .json({'message': 'Login feito!', 'status': infos.status, 'userName': infos.name})
                       .cookie("sid", 
                            path='/',
                            valor=infos.token, 
                            max_age=36000, 
                            samesite='Lax', 
                            httponly=true, 
                            secure=true,
                            domain=system.getenv('DOMAINS')
                       ); # Assina o token com id de sessão
            }
            return JinkerResponse().json({'status': infos.status, 'message': infos.message})
        }
        catch (Exception){
            post(<yellow>f"Erro interno no servidor em" + <purple>"(Path: /home/kleberdevion/projetos/painel/api/main.pr" + <purple>f"Funct: handlerLogin()) --> {Exception}")
            return JinkerResponse()
                   .header('Content-Type', 'application/json')
                   .json({'status': 500, 'message': 'Server Internal Error'})
        }
    }

    # Criar conta de usuario
    @Routesapp.post('/sing-inpanel', model=SinginPAINEL, auth=CrossOrigin.origins(), middleware=Routesapp.middleware)
    public funct handlerSingin(self, dict form){
        if (!PanelDoctors.DoctorBody(form)){
            return JinkerResponse()
                   .header('Content-Type', 'application/json')
                   .json({'status': 400, 'message': 'Bad request'})
        }
        try{
            dict infos = PersonOperadorSingIn.singin(data=form)
            if (infos.status == 201){
                return JinkerResponse()
                       .header('Content-Type', 'application/json')
                       .json({'message': infos.message, 'status': infos.status})
            }
            return JinkerResponse().json({'status': infos.status, 'message': infos.message})
        }
        catch (Exception){
            post(<yellow>f"Erro interno no servidor em" + <purple>"(Path: /home/kleberdevion/projetos/painel/api/main.pr" + <purple>f"Funct: handlerSingin()) --> {Exception}")
            return JinkerResponse()
                   .header('Content-Type', 'application/json')
                   .json({'status': 500, 'message': 'Server Internal Error'})
        }
    }

    # Este endpoint recebe toda chamada webhook dos serviços web da TEC-SOL
    @Routesapp.post('/webhook/services/warning:schema', auth=CrossOrigin.origins(), middleware=Routesapp.middleware)
    public funct handlerWebHook(self, dict schema){
        if (!PanelDoctors.webhookDoctor(schema)){
            return JinkerResponse()
                   .header('Content-Type', 'application/json')
                   .json({'status': 400, 'message': 'Bad request'})
        }
        try{
            if (UNTILS.getTokensWebhook(request.headers.get('Authorization')) == False){
                return JinkerResponse()
                       .header('Content-Type', 'application/json')
                       .json({'status': 403, 'message': 'Forbidden'})
            }
            return warnsInsertion.OcorrenciaInsertion(info=schema)
        }
        catch (Exception){
            post(<yellow>f"Erro interno no servidor em" + <purple>"(Path: /home/kleberdevion/projetos/painel/api/main.pr" + <purple>f"Funct: handlerWebhook()) --> {Exception}")
            return JinkerResponse()
                   .header('Content-Type', 'application/json')
                   .json({'status': 500, 'message': 'Server Internal Error'})
        }
    }

    # Endpoint para buscar ocorrencias de erro dos serviços web da TEC-SOL
    @Routesapp.get('/ocorrencias:data', auth=CrossOrigin.origins(), middleware=Routesapp.middleware)
    public funct handlerOcorrencias(self, dict data){
        try{
            if (UNTILS.getTokensWebhook(request.headers.get('Authorization')) == False){
                return JinkerResponse()
                       .header('Content-Type', 'application/json')
                       .json({'status': 403, 'message': 'Forbidden'})
            }
            if (data){
                return OperatorDatabase.GetOcorrencias(data)
            }
            elif (not data){
                return OperatorDatabase.GetAllOcorrencias()
            }
            else{
                return JinkerResponse()
                       .header('Content-Type', 'application/json')
                       .json({'status': 400, 'message': 'Bad request'})
            }
        }
        catch (Exception){
            post(<yellow>f"Erro interno no servidor em" + <purple>"(Path: /home/kleberdevion/projetos/painel/api/main.pr" + <purple>f"Funct: handlerOcorrencias()) --> {Exception}")
            return JinkerResponse()
                   .header('Content-Type', 'application/json')
                   .json({'status': 500, 'message': 'Server Internal Error'})
        }
    }

    @Routesapp.socket('/real-time:room', channel=True)
    public funct handlerRealTime(self){
        try{
            if (request.path_param('room')){
                dictionary message = request.get_json()
                string roomId = request.path_param('room')
                Routesapp.socket.emit(payload=message, room_id=roomId)
            }
            return 'Erro: Vc é burro ??'
        }
        catch (Exception){
            post(<yellow>f"Erro interno no servidor em" + <purple>"(Path: /home/kleberdevion/projetos/painel/api/main.pr" + <purple>f"Funct: handlerRealTime()) --> {Exception}")
            return JinkerResponse()
                   .header('Content-Type', 'application/json')
                   .json({'status': 500, 'message': 'Server Internal Error'})
        }
    }

    @Routesapp.get('/new-token', auth=CrossOrigin.origins(), middleware=Routesapp.middleware)
    public funct handlerNewToken(self){
        return 'sem func'
    }

}