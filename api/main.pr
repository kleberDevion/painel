from jinker import Jinker, JinkerRequest, JinkerResponse, cors, request

import os as system
import dotenv as env
import sys

# Modelo de login.
from '/home/kleberdevion/projetos/painel/api/schemas/models/login.pr' import RotaLoginPAINEL, RotaSinginPAINEL;
from '/home/kleberdevion/projetos/painel/api/service/helpers/doctor.pr' import PanelDoctors
from '/home/kleberdevion/projetos/painel/api/service/acesso_painel.pr' import PersonOperador
from '/home/kleberdevion/projetos/painel/api/service/controlWebhook.pr' import warnsInsertion
from '/home/kleberdevion/projetos/painel/api/service/helpers/UNTILS.pr' import UNTILS
from '/home/kleberdevion/projetos/painel/api/service/database.conn/db.pr' import *
#from '/home/kleberdevion/projetos/painel/api/service/decorators/login.pr' import schemaLogin

env.load('/home/kleberdevion/projetos/painel/.env');

public class warningPanel(){
    #private static list dns = system.getenv('DOMAINS')
    # Routesapp não carrega __name__ pois não e este aqruivo que executa como main
    public static Object Routesapp = Jinker( 
        oauth={
            poolip: true, 
            rate: true, 
            tls: true, 
            bloq: 200, 
            cert: '/home/kleberdevion/projetos/painel/api/tls/certificate.jinkerTls', 
            key: '/home/kleberdevion/projetos/painel/api/tls/key.jinkerTls.key'
        }, route_prefix='/api/v7/painel/'
    );
    private static Object CrossOrigin = cors(origins=['https://api.tecsolengenharia.com.br', 'https://auth.tecsolengenharia.com.br'])
    # MIDDLEWARE PARA AUTENTICAÇÃO DE TOKEN WEBHOOK
    @Routesapp.middleware()
    public funct middle(self){
        str headers = request.header(key='Authorization')
        if (UNTILS.getTokensWebhook(headers) == false){
            return JinkerResponse()
                   .header('Content-Type', 'application/json')
                   .json({'status': 403, 'message': 'Forbidden'})
        }
    }

    # Rota de teste para verificar se o servidor está online
    @Routesapp.get('/', auth=CrossOrigin.origins(), middleware=Routesapp.middleware)
    public funct healthcheck(self){
        return JinkerResponse()
               .header('Content-Type', 'application/json')
               .json({'status': 200, 'message': 'Vai se fuder'})
    }

    # Rota de login no painel
    @Routesapp.post('/loginpanel:form', auth=CrossOrigin.origins(), model=RotaLoginPAINEL, middleware=Routesapp.middleware)
    public funct handlerLogin(self, dict form){
        if (!PanelDoctors.DoctorBody(form) == false){
            return JinkerResponse()
                   .header('Content-Type', 'application/json')
                   .json({'status': 400, 'message': 'Bad request'})
        }
        try{
            dict infos = PersonOperador.login(data=form)
            if (infos.status == 200){
                return JinkerResponse()
                       .json({'message': 'Login feito!', 'status': infos.status, 'userName': infos.name})
                       .cookie("sid", 
                            path='/',
                            valor=infos.token, 
                            max_age=36000, 
                            samesite='Lax', 
                            httponly=true, 
                            secure=true,
                            domain=system.getenv('DOMAINS')
                       ); # Assina o token com id de sessão
            }
            return JinkerResponse().json({'status': infos.status, 'message': infos.message})
        }
        catch (Exception e)
        {
            sys.stdout.writeln(<2196f7>f'Erro interno no servidor em ( /loginpanel:form ) - {e}')
            return JinkerResponse()
                   .header('Content-Type', 'application/json')
                   .json({'status': 500, 'message': 'Server Internal Error'})
        }
    }

    # Criar conta de usuario
    @Routesapp.post('/sing-inpanel', model=RotaSinginPAINEL, auth=CrossOrigin.origins(), middleware=Routesapp.middleware)
    public funct handlerSingin(self, dict form){
        if (!PanelDoctors.DoctorBody(form)){
            return JinkerResponse()
                   .header('Content-Type', 'application/json')
                   .json({'status': 400, 'message': 'Bad request'})
        }
        try{
            dict infos = PersonOperador.singin(data=form)
            if (infos.status == 201){
                return JinkerResponse()
                       .header('Content-Type', 'application/json')
                       .json({'message': infos.message, 'status': infos.status})
            }
            return JinkerResponse().json({'status': infos.status, 'message': infos.message})
        }
        catch (Exception e)
        {
            post(f'Erro interno no servidor em ( /sing-inpanel:form ) - {e}')
            return JinkerResponse()
                   .header('Content-Type', 'application/json')
                   .json({'status': 500, 'message': 'Server Internal Error'})
        }
    }

    # Este endpoint recebe toda chamada webhook dos serviços web da TEC-SOL
    @Routesapp.post('/webhook/services/warning:schema', auth=CrossOrigin.origins(), middleware=Routesapp.middleware)
    public funct handlerWebHook(self, dict schema){
        if (!PanelDoctors.webhookDoctor(schema)){
            return JinkerResponse()
                   .header('Content-Type', 'application/json')
                   .json({'status': 400, 'message': 'Bad request'})
        }
        try{
            if (UNTILS.getTokensWebhook(request.headers.get('Authorization') == False)){
                return JinkerResponse()
                       .header('Content-Type', 'application/json')
                       .json({'status': 403, 'message': 'Forbidden'})
            }
            return warnsInsertion.OcorrenciaInsertion(info=schema)
        }
        catch (Exception e)
        {
            post(f"Erro interno no servidor em ( warningPanel().handlerWebhook() ) --> {e}");
            return JinkerResponse()
                   .header('Content-Type', 'application/json')
                   .json({'status': 500, 'message': 'Server Internal Error'})
        }
    }

    # Endpoint para buscar ocorrencias de erro dos serviços web da TEC-SOL
    @Routesapp.get('/ocorrencias:data', auth=CrossOrigin.origins(), middleware=Routesapp.middleware)
    public funct handlerGetOcorrencias(self, dict data){
        try{
            if (request.headers.get('Authorization') != system.getenv('WEBHOOK_AUTHORIZATION')){
                return JinkerResponse()
                       .header('Content-Type', 'application/json')
                       .json({'status': 403, 'message': 'Forbidden'})
            }
            if (data){
                return OperatorDatabase.GetOcorrencias(data)
            }
            elif (not data){
                return OperatorDatabase.GetAllOcorrencias()
            }
            else{
                return JinkerResponse()
                       .header('Content-Type', 'application/json')
                       .json({'status': 400, 'message': 'Bad request'})
            }
        }
        catch (Exception e)
        {
            post(f"Erro interno no servidor em ( warningPanel().handlerGetOcorrencias() ) --> {e}");
            return JinkerResponse()
                   .header('Content-Type', 'application/json')
                   .json({'status': 500, 'message': 'Server Internal Error'})
        }
    }
}