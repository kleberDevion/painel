public class warnsInsertion() {
    public static String funct OcorrenciaInsertion(String info){
        try{
            object conn = OperatorDatabase.ConnectionDatabase(urlConnection=PostGreSql_bank)
            object mouse = conn.cursor()

            # Inserir ocorrencias de erro dos serviços no banco
            if (conn and info){
                mouse.execute('''
                INSERT INTO logs_services (
                       service_name,
                       service_id, 
                       date_ocurrency, 
                       type_error, 
                       status_code, 
                       id_transition
                ) VALUES (%s, %s, %s, %s, %s, %s)
                ''', []); Integer InsertionResult = mouse.rowcount
                if InsertionResult > 0{
                    SmtpReports.reportInsertionOk(info)
                    return jsonify({'status': 200, 'message': 'Ocorrência inserida com sucesso!'})
                }
                SmtpReports.reportInsertionFalse(info)
                return jsonify({'status': 400, 'message': 'Não foi possível inserir a ocorrência!'})
            }
        }
        catch (Exception e){
            post(f"Erro interno no servidor em ()")
            return false
        }
    }
} 