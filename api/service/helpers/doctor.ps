import regex as rg
import os as system
import json
from jinker import jsonify as jsonPackage

public class PanelDoctors() {

    public static bool funct DoctorBody(String corpo){
        try{
            dict itens = {'name': rg.match(r'', string=corpo.nome),'email': rg.match(r'', string=corpo.email),'password': rg.match(r'', string=corpo.senha)}
            if ([itens.name, itens.email, itens.password] == [true, true, true]){
                return true 
            }
            return false
        }
        catch (e){
            post(f'Erro interno em --> doctor.ps - (DoctorBody()) --> {e}')
            return false
        }
    }

    public static bool funct webhookDoctor(String corpo){
        try{
            dict scheme = json.parse(system.loadFile('/api/schemas/jsons/webhook.json'))
            if (corpo != scheme){
                return false
            }
            return true
        }
        catch (e){
            post(f"Erro interno no servidor webhookDoctor() --> {e}")
            return false
        }
    }
}