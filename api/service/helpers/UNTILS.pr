import os as system
import dotenv as env
import psodbc

public class UNTILS {
    private static String urlConnection = system.getenv('DATABASE_TOKENS_WEBHOOK')

    public static funct getTokensWebhook(dict token){
        try{
            env.load('/home/kleberdevion/projetos/painel/.env');
            object conn = psodbc.connect(url=urlConnection)
            object mouse = conn.cursor()
            if (conn){
                mouse.execute('''
                SELECT token FROM tokens_webhook WHERE token_name = ?
                ''', [token.token_name])
                dict result = mouse.fetchall()
                if (result){ return True }
                return False
            }
            raise ValueError('Erro interno: Não foi possível buscar os tokens do webhook')
        }
        catch (Exception){
            post(<yellow>f"Erro interno no servidor em" + <purple>"(Path: /home/kleberdevion/projetos/painel/api/service/helpers/UNTILS.pr" + <purple>f"Funct: getTokensWebhook()) --> {Exception}")
            return false
        }
    }
}