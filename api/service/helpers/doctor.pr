import regex as rg
import os as system
import json

public class PanelDoctors {

    public static funct DoctorBody(dict corpo){
        try{
            dict itens = {
                'name': rg.match(r"/^[a-zA-Z]+(?: [a-zA-Z]+)*$/", corpo.nome),
                'email': rg.match(r"^[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9](?:[a-zA-Z0-9-]*[a-zA-Z0-9])?(?:\.[a-zA-Z0-9](?:[a-zA-Z0-9-]*[a-zA-Z0-9])?)*$", corpo.email),
                'password': rg.match(r"^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?&])[A-Za-z0-9@$!%*?&]{8,30}$", corpo.senha)
            }
            if ([itens.name, itens.email, itens.password] == [true, true, true]){
                return true 
            }
            return false
        }
        catch (e){
            post(f'Erro interno em --> doctor.ps - (DoctorBody()) --> {e}')
            return false
        }
    }

    public static funct webhookDoctor(dict corpo){
        try{
            dict scheme = json.parse(system.loadFile('/api/schemas/jsons/webhook.json'))
            if (corpo != scheme){
                return false
            }
            return true
        }
        catch (e){
            post(f"Erro interno no servidor webhookDoctor() --> {e}")
            return false
        }
    }

}