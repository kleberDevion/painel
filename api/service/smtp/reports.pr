import mail
import os as environment
import date
import json

import '/home/kleberdevion/projetos/painel/api/service/decorators/StateAnalise.pr' *

public class SmtpReports() {
    public static String subject = "ServerPanelError - Tecsol Engenharia";
    public static String recepter = environment.getenv('SMTP_TO_REPORTS');
    public static String sender = environment.getenv('SMTP_FROM_REPORTS');
    public static String password = environment.getenv('SMTP_PASSWORD_REPORTS');
    # Corpo HTML enviado nos avisos.
    public static PoolFile body_html = environment.loadFile('/home/kleberdevion/projetos/painel/api/service/templates/REPORT_BODY.html');
   
    # info e o dict que e passado com os registros de erro dos serviços
    @statefunct
    public static funct reportInsertionOk(dict info_error){
        dict inf = json.parse(info_error)
        try{
            string bodyFormat = body_html.raplace(['ERROR_TYPE', 'DATE_OCURRENCY', 'SERVICE_NAME', 'ID_TRANSITION'], [
                inf.info.type_error, inf.info.data_ocorrencia, 
                inf.info.nome_servico, inf.info.id_transition
            ]);
            object smtp = mail.MailMessage()
            smtp.from_address(sender)
            smtp.to(recepter)
            smtp.subject(subject)
            smtp.body(bodyFormat, is_html=true)

            object smtpClient = mail.MailServer()
            smtpClient.conn('smtp.gmail.com', 587, tls=true)
            smtpClient.login(password, sender)

            if (smtpClient and smtp){
                smtpClient.send(smtp); smtpClient.quit()
                return Null,'1' # Numeração para debug de forma eficiente (para mim e eficiente pois sei o pq do erro, na maioria das vezes e o motor da lang, não o codigo, ai vou e corrijo)
            }
            return Null,'2'
           
        }
        catch (Exception e){
            post(f"Erro interno no servidor em ( SmtpReports().sendMail() ) --> {e}");
            return Null,'3'
        }
    }

    @statefunct
    public static funct reportInsertionFalse(dict info_error){
        dict inf = json.parse(info_error)
        try{
            string bodyFormat = body_html.raplace(['ERROR_TYPE', 'DATE_OCURRENCY', 'SERVICE_NAME', 'ID_TRANSITION'], [
                inf.info.type_error, inf.info.data_ocorrencia, 
                inf.info.nome_servico, inf.info.id_transition
            ]);
            object smtp = mail.MailMessage()
            smtp.from_address(sender)
            smtp.to(recepter)
            smtp.subject(subject)
            smtp.body(bodyFormat, is_html=true)

            object smtpClient = mail.MailServer()
            smtpClient.conn('smtp.gmail.com', 587, tls=true)
            smtpClient.login(environment.getenv('SMTP_PASSWORD_REPORTS'), sender)

            if (smtpClient and smtp){
                smtpClient.send(smtp); smtpClient.quit()
                return Null,'1'
            }
            return Null,'2'
           
        }
        catch (Exception e){
            post(f"Erro interno no servidor em ( SmtpReports().sendMail() ) --> {e}");
            return Null,'3'
        }
    }
}