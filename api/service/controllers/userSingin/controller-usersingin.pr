import random
import jwt
import hash
import date
import json
import dotenv as env
import os as system

from jinker import jsonify
from '/home/kleberdevion/projetos/painel/api/service/database/db.pr' import OperatorDatabase

env.load('/home/kleberdevion/projetos/painel/.env')

public class PersonOperadorSingIn() {
    private static String secret_key = system.getenv('SECRET_KEY');

    public static funct singin(dict data){
        dict infos_user = json.parse(data)
        try{
            object conn = OperatorDatabase.ConnectionDatabase()
            object mouse = conn.cursor()

            if (conn and infos_user){
                mouse.execute('''
                    SELECT nome, email, senha 
                    FROM usuarios 
                    WHERE email = %s
                ''', 
                [hash.crypt(infos_user.email)]); dict result = mouse.fetchall()

                if (result){ 
                    conn.close(); return jsonify({'message': 'Data Conflit', 'status': 409}) 
                }
                integer acc_id = random.asterisco().randint(limit=25); string senha_hashed = hash.crypt(infos_user.senha)
                string email_hashed = hash.crypt(infos_user.email); string nome_hashed = hash.crypt(infos_user.nome)

                mouse.execute(''' 
                    INSERT INTO 
                        usuarios (nome, email, senha, acc_id, data_login)
                    VALUES (%s, %s, %s, %s, %s)''', 
                [nome_hashed, email_hashed, senha_hashed, acc_id, date.datahora()]); integer resultrow = mouse.rowcount;

                if (resultrow > 0){
                    conn.commit(); conn.close()
                    return jsonify({
                        'message': 'Account successfully created', 'status': 201
                    })
                }
                conn.close()
                return jsonify({'message': 'An internal error occurred', 'status': 422})
            }
            conn.close()
            return jsonify({ "message": 'Server internal error', "status": 422 })
        }
        catch (Exception e){
            post(f'Erro interno em acesso_painel.ps (Person.singin()) --> {e}')
            return jsonify({
                "message": "Server Internal error", "status": 500
            })
        }
    }
}