import psodbc
import os as system
import dotenv as env
import sqlite3


env.load('/home/kleberdevion/projetos/painel/.env');

public class OperatorDatabase() {
    private static dictionary banks = {
        'postgre': system.getenv('DATABASE_POSTGRESQL'),
        'mysql': system.getenv('DATABASE_MYSQL'),
        'sqlite': system.getenv('DATABASE_SQLITE'),
    }
   
    public static Object funct ConnectionDatabase(){
        object conn = psodbc.connect(banks['postgre'])
        if (conn){
            return conn;
        }
        raise ConnectionError('Erro interno: Conexão com banco falhou')
    } 

    public NonNull static Object funct GetOcorrencias(dict data){
        object conn = OperatorDatabase.ConnectionDatabase()
        object mouse = conn.cursor()
        if (conn and data){
            mouse.execute('''
            SELECT service_name,
                service_id, 
                date_ocurrency, 
                type_error, 
                status_code, 
                id_transition
            FROM logs_services WHERE date_ocurrency = %s
            ''', [data.date])
            list ocorrencias = mouse.fetchall()
            return ocorrencias
        }
        raise ValueError('Erro interno: Não foi possível buscar as ocorrências')
    }

    # Depois irei terminar de criar a lib de paginação, e irei importar e utilizar aqui nesta funct.
    public static Object funct GetAllOcorrencias(){
        object conn = OperatorDatabase.ConnectionDatabase()
        object mouse = conn.cursor()
        if (conn){
            mouse.execute('''
            SELECT *
            FROM logs_services
            ''')
            list ocorrencias = mouse.fetchall()
            return ocorrencias
        }
        raise ValueError('Erro interno: Não foi possível buscar as ocorrências')
    }
}